{
  "name": "@invergent-ai/rune-sdk",
  "version": "0.1.0",
  "description": "JavaScript and TypeScript SDK for the Surogate Rune API",
  "license": "MIT",
  "author": "Invergent",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "UPSTREAM.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "check:version": "node scripts/check-version.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "npm run check",
    "push:npm": "npm publish",
    "push:npm:dry": "npm publish --dry-run",
    "push:jsr": "npm run check && jsr publish",
    "push:jsr:dry": "npm run check && jsr publish --dry-run --allow-dirty",
    "demo": "tsx examples/demo.ts",
    "check": "npm run lint && npm run typecheck && npm run check:version && npm run test:coverage && npm run build && npm run test:dist && npm run check:package",
    "docs": "npm ci --prefix docs --ignore-scripts --no-audit --no-fund && npm run --prefix docs build",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.11",
    "git-cliff": "2.13.1",
    "jsr": "^0.14.3",
    "publint": "^0.3.24",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invergent-ai/rune-sdk-js.git"
  },
  "homepage": "https://github.com/invergent-ai/rune-sdk-js#readme",
  "bugs": {
    "url": "https://github.com/invergent-ai/rune-sdk-js/issues"
  }
}
